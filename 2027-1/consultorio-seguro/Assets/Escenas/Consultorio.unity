  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>CONTROLES E INTERACCI\xD3N</b>\n\nWASD / flechas \xB7 Caminar\nRat\xF3n
    \xB7 Mirar     Shift \xB7 Correr\nEsc \xB7 Pausa y manual\n\nAc\xE9rcate y apunta
    con el punto blanco.\nPulsa <b>E</b> cuando aparezca la indicaci\xF3n.\n\n<b>1.</b>
    Lee la hoja de pr\xE1ctica con E.\n<b>2.</b> Sigue el paso que indica la pantalla.\n<b>3.</b>
    Toma el residuo con E.\n<b>4.</b> Apunta al recipiente y pulsa E.\n\nPara devolverlo:
    mira al vac\xEDo y pulsa E.\nPara repetir: Esc \u2192 Reiniciar pr\xE1ctica."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
