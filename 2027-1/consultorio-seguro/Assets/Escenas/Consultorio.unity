  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>CONTROLES E INTERACCI\xD3N</b>\n\nWASD / flechas \xB7 Caminar\nRat\xF3n
    \xB7 Mirar     Shift \xB7 Correr\nEsc \xB7 Pausa y manual\n\nAc\xE9rcate y apunta
    con el punto blanco.\nPulsa <b>E</b> cuando aparezca la indicaci\xF3n.\nContorno
    blanco \xB7 Objeto cercano\nContorno dorado \xB7 Objeto apuntado\n\n<b>1.</b>
    Lee la hoja de pr\xE1ctica con E.\n<b>2.</b> Sigue el paso que indica la pantalla.\n<b>3.</b>
    Toma el residuo con E.\n<b>4.</b> Apunta al recipiente y pulsa E.\n\nPara devolverlo:
    mira al vac\xEDo y pulsa E.\nPara repetir: Esc \u2192 Reiniciar pr\xE1ctica."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
